import importlib
import inspect
import random
from pathlib import Path

import pandas as pd
import torch
import torch.nn as nn
import pytorch_lightning as pl


def _cfg_get(cfg, key, default=None):

    if cfg is None:
        return default

    if isinstance(cfg, dict):
        return cfg.get(
            key,
            default,
        )

    return getattr(
        cfg,
        key,
        default,
    )


def _class_name_from_module(name):

    if "_" not in name:
        return name

    parts = name.split("_")

    return "".join(
        p[0].upper() + p[1:]
        for p in parts
        if p
    )


def _pearson_per_gene(
    preds: torch.Tensor,
    targets: torch.Tensor,
    eps: float = 1e-12,
):
    """
    Compute Pearson correlation separately for each gene.

    Parameters
    ----------
    preds:
        [N_slides, n_genes]

    targets:
        [N_slides, n_genes]

    Returns
    -------
    r:
        [n_genes]

    Notes
    -----
    NO clipping / clamp is applied.

    This guarantees that the metric computed here agrees
    with the raw predictions saved to CSV.
    """

    if preds.ndim != 2:
        raise ValueError(
            f"preds must be 2-D, got {preds.shape}."
        )

    if targets.ndim != 2:
        raise ValueError(
            f"targets must be 2-D, got {targets.shape}."
        )

    if preds.shape != targets.shape:
        raise ValueError(
            "preds and targets must have identical shapes, "
            f"got {preds.shape} and {targets.shape}."
        )

    preds = preds.float()
    targets = targets.float()

    x = (
        preds
        - preds.mean(
            dim=0,
            keepdim=True,
        )
    )

    y = (
        targets
        - targets.mean(
            dim=0,
            keepdim=True,
        )
    )

    numerator = (
        x * y
    ).sum(
        dim=0
    )

    x_ss = (
        x.square()
    ).sum(
        dim=0
    )

    y_ss = (
        y.square()
    ).sum(
        dim=0
    )

    denominator = torch.sqrt(
        x_ss * y_ss
    )

    r = torch.where(
        denominator > eps,
        numerator
        / denominator.clamp_min(
            eps
        ),
        torch.zeros_like(
            numerator
        ),
    )

    return r


class ModelInterfaceRegression(
    pl.LightningModule
):
    """
    Lightning interface for multi-gene
    expression regression.

    Batch format
    ------------
    Standard MIL:

        (
            feats_list,
            targets,
            optional_slide_id
        )

    where

        feats_list:
            list containing one tensor [N_tiles, D]

        targets:
            [1, n_genes]

    The recommended WSI MIL batch size remains 1.
    """

    def __init__(
        self,
        model_cfg,
        optimizer_cfg,
        data_cfg,
        log_path,
        gene_ids,
        model_tag="REGRESSION",
        csv_dir="output_csv/",
        csv_file_name="regression_results.csv",
    ):
        super().__init__()

        self.save_hyperparameters()

        self.model_cfg = model_cfg
        self.optimizer_cfg = optimizer_cfg
        self.data_cfg = data_cfg

        self.gene_ids = list(
            gene_ids
        )

        self.n_genes = len(
            self.gene_ids
        )

        if self.n_genes == 0:
            raise ValueError(
                "gene_ids cannot be empty."
            )

        self.model_tag = model_tag

        self.log_path = Path(
            log_path
        )

        self.log_path.mkdir(
            parents=True,
            exist_ok=True,
        )

        self.csv_dir = Path(
            csv_dir
        )

        self.csv_dir.mkdir(
            parents=True,
            exist_ok=True,
        )

        self.csv_path = (
            self.csv_dir
            / csv_file_name
        )

        self.shuffle = bool(
            _cfg_get(
                data_cfg,
                "data_shuffle",
                False,
            )
        )

        self.count = 0

        # --------------------------------------------------
        # Model
        # --------------------------------------------------
        self.model = self._load_model(
            model_cfg
        )

        # --------------------------------------------------
        # Regression loss
        # --------------------------------------------------
        self.loss_fn = nn.MSELoss()

        # --------------------------------------------------
        # Epoch buffers
        # --------------------------------------------------
        self.validation_step_outputs = []
        self.test_step_outputs = []

    # ======================================================
    # Model
    # ======================================================
    def _load_model(
        self,
        model_cfg,
    ):

        name = _cfg_get(
            model_cfg,
            "name",
            None,
        )

        if name is None:
            raise ValueError(
                "model_cfg.name must be specified."
            )

        class_name = (
            _class_name_from_module(
                name
            )
        )

        try:

            module = importlib.import_module(
                f"models.{name}"
            )

            Model = getattr(
                module,
                class_name,
            )

        except Exception as exc:

            raise ValueError(
                f"Cannot import model "
                f"'models.{name}.{class_name}'.\n"
                f"Expected file : models/{name}.py\n"
                f"Expected class: {class_name}\n"
                f"Original error: {exc}"
            ) from exc

        signature = inspect.signature(
            Model.__init__
        )

        params = [
            p.name
            for p
            in signature.parameters.values()
            if p.name != "self"
        ]

        kwargs = {}

        for key in params:

            value = _cfg_get(
                model_cfg,
                key,
                None,
            )

            if value is not None:
                kwargs[key] = value

        model = Model(
            **kwargs
        )

        if (
            hasattr(
                model,
                "n_genes",
            )
            and int(
                model.n_genes
            )
            != self.n_genes
        ):
            raise ValueError(
                "Number of genes in model and gene_ids differs: "
                f"model.n_genes={model.n_genes}, "
                f"len(gene_ids)={self.n_genes}."
            )

        return model

    # ======================================================
    # Progress bar
    # ======================================================
    def get_progress_bar_dict(self):

        items = super().get_progress_bar_dict()

        items.pop(
            "v_num",
            None,
        )

        return items

    # ======================================================
    # Batch handling
    # ======================================================
    def _run_batch(
        self,
        batch,
    ):
        """
        Returns
        -------
        preds:
            [B, n_genes]

        targets:
            [B, n_genes]
        """

        if len(batch) < 2:
            raise ValueError(
                "Regression batch must contain "
                "at least (features, targets)."
            )

        feats = batch[0]
        targets = batch[1]

        # --------------------------------------------------
        # Variable-length MIL bags
        #
        # Recommended path:
        #
        # batch_size = 1
        # --------------------------------------------------
        if isinstance(
            feats,
            (list, tuple),
        ):

            if len(feats) != 1:

                raise ValueError(
                    "Variable-length WSI bags currently require "
                    "batch_size=1. "
                    f"Received {len(feats)} bags. "
                    "Do not silently discard bags; either use "
                    "batch_size=1 or implement explicit padding/masks."
                )

            data = (
                feats[0]
                .unsqueeze(0)
                .to(self.device)
            )

        else:

            data = feats.to(
                self.device
            )

            if data.ndim == 2:
                data = data.unsqueeze(
                    0
                )

        if data.ndim != 3:
            raise ValueError(
                "WSI features must have shape "
                "[B, N_tiles, feat_dim], "
                f"received {tuple(data.shape)}."
            )

        targets = targets.to(
            self.device
        ).float()

        if targets.ndim == 1:
            targets = targets.unsqueeze(
                0
            )

        if targets.ndim != 2:
            raise ValueError(
                "targets must have shape [B, n_genes], "
                f"received {tuple(targets.shape)}."
            )

        if (
            targets.shape[1]
            != self.n_genes
        ):
            raise ValueError(
                f"Expected {self.n_genes} genes, "
                f"but received target shape {tuple(targets.shape)}."
            )

        if (
            data.shape[0]
            != targets.shape[0]
        ):
            raise ValueError(
                "Feature and target batch sizes differ: "
                f"{data.shape[0]} vs {targets.shape[0]}."
            )

        results = self.model(
            data=data
        )

        if "preds" not in results:
            raise KeyError(
                "Regression model must return "
                "results['preds']."
            )

        preds = results[
            "preds"
        ]

        if preds.shape != targets.shape:
            raise ValueError(
                "Prediction and target shape mismatch: "
                f"{tuple(preds.shape)} vs "
                f"{tuple(targets.shape)}."
            )

        return (
            preds,
            targets,
        )

    # ======================================================
    # Training
    # ======================================================
    def training_step(
        self,
        batch,
        batch_idx,
    ):

        preds, targets = (
            self._run_batch(
                batch
            )
        )

        loss = self.loss_fn(
            preds,
            targets,
        )

        self.log(
            "train_loss",
            loss,
            on_step=False,
            on_epoch=True,
            prog_bar=True,
            batch_size=targets.shape[0],
            sync_dist=True,
        )

        return loss

    # ======================================================
    # Validation
    # ======================================================
    def validation_step(
        self,
        batch,
        batch_idx,
    ):

        preds, targets = (
            self._run_batch(
                batch
            )
        )

        loss = self.loss_fn(
            preds,
            targets,
        )

        self.validation_step_outputs.append(
            {
                "preds":
                    preds
                    .detach()
                    .cpu(),

                "targets":
                    targets
                    .detach()
                    .cpu(),

                "loss":
                    loss
                    .detach()
                    .cpu(),
            }
        )

        return loss

    def on_validation_epoch_end(self):

        if not self.validation_step_outputs:
            return

        all_preds = torch.cat(
            [
                o["preds"]
                for o
                in self.validation_step_outputs
            ],
            dim=0,
        )

        all_targets = torch.cat(
            [
                o["targets"]
                for o
                in self.validation_step_outputs
            ],
            dim=0,
        )

        val_loss = torch.stack(
            [
                o["loss"]
                for o
                in self.validation_step_outputs
            ]
        ).mean()

        per_gene_r = _pearson_per_gene(
            all_preds,
            all_targets,
        )

        mean_r = per_gene_r.mean()

        self.log(
            "val_loss",
            val_loss.to(
                self.device
            ),
            prog_bar=True,
            sync_dist=True,
            batch_size=1,
        )

        self.log(
            "val_pearson",
            mean_r.to(
                self.device
            ),
            prog_bar=True,
            sync_dist=True,
            batch_size=1,
        )

        if not self.trainer.sanity_checking:

            self.print(
                "\n"
                + "=" * 48
            )

            self.print(
                f"Epoch {self.current_epoch}"
            )

            self.print(
                f"val_loss="
                f"{float(val_loss):.6f}"
            )

            self.print(
                f"mean_pearson="
                f"{float(mean_r):.6f}"
            )

            self.print(
                "\nFirst genes:"
            )

            for gid, r in zip(
                self.gene_ids[:10],
                per_gene_r.tolist()[:10],
            ):

                self.print(
                    f"{gid}: "
                    f"r={r:.4f}"
                )

            if self.n_genes > 10:

                self.print(
                    f"... "
                    f"{self.n_genes - 10} "
                    f"additional genes"
                )

            self.print(
                "=" * 48
            )

            row = {
                "epoch":
                    int(
                        self.current_epoch
                    ),

                "model_tag":
                    self.model_tag,

                "val_loss":
                    float(
                        val_loss
                    ),

                "val_mean_pearson":
                    float(
                        mean_r
                    ),
            }

            for gid, r in zip(
                self.gene_ids,
                per_gene_r.tolist(),
            ):

                row[
                    f"pearson_{gid}"
                ] = float(r)

            if self.trainer.is_global_zero:

                write_header = (
                    not self.csv_path.exists()
                )

                pd.DataFrame(
                    [row]
                ).to_csv(
                    self.csv_path,
                    mode="a",
                    header=write_header,
                    index=False,
                )

        self.validation_step_outputs.clear()

        if self.shuffle:

            self.count += 1

            random.seed(
                self.count * 50
            )

    # ======================================================
    # Test
    # ======================================================
    @staticmethod
    def _normalize_slide_ids(
        slide_info,
        batch_size,
        batch_idx,
    ):

        if slide_info is None:

            return [
                f"sample_{batch_idx}_{i}"
                for i in range(
                    batch_size
                )
            ]

        if isinstance(
            slide_info,
            str,
        ):

            ids = [
                slide_info
            ]

        elif isinstance(
            slide_info,
            (list, tuple),
        ):

            ids = [
                str(x)
                for x
                in slide_info
            ]

        elif torch.is_tensor(
            slide_info
        ):

            ids = [
                str(x.item())
                for x
                in slide_info.view(-1)
            ]

        else:

            ids = [
                str(
                    slide_info
                )
            ]

        if len(ids) != batch_size:

            if (
                batch_size == 1
                and len(ids) >= 1
            ):

                ids = [
                    ids[0]
                ]

            else:

                raise ValueError(
                    "Number of slide IDs does not match "
                    f"batch size: {len(ids)} vs {batch_size}."
                )

        return ids

    def test_step(
        self,
        batch,
        batch_idx,
    ):

        preds, targets = (
            self._run_batch(
                batch
            )
        )

        loss = self.loss_fn(
            preds,
            targets,
        )

        slide_info = (
            batch[2]
            if len(batch) >= 3
            else None
        )

        slide_ids = (
            self._normalize_slide_ids(
                slide_info,
                preds.shape[0],
                batch_idx,
            )
        )

        self.test_step_outputs.append(
            {
                "preds":
                    preds
                    .detach()
                    .cpu(),

                "targets":
                    targets
                    .detach()
                    .cpu(),

                "loss":
                    loss
                    .detach()
                    .cpu(),

                "slide_ids":
                    slide_ids,
            }
        )

        return loss

    def on_test_epoch_end(self):

        if not self.test_step_outputs:

            self.print(
                "[ERROR] No test outputs found."
            )

            return

        all_preds = torch.cat(
            [
                o["preds"]
                for o
                in self.test_step_outputs
            ],
            dim=0,
        )

        all_targets = torch.cat(
            [
                o["targets"]
                for o
                in self.test_step_outputs
            ],
            dim=0,
        )

        test_loss = torch.stack(
            [
                o["loss"]
                for o
                in self.test_step_outputs
            ]
        ).mean()

        all_slide_ids = [
            sid
            for o
            in self.test_step_outputs
            for sid
            in o["slide_ids"]
        ]

        per_gene_r = _pearson_per_gene(
            all_preds,
            all_targets,
        )

        mean_r = per_gene_r.mean()

        self.print(
            "\n"
            + "=" * 48
        )

        self.print(
            "FINAL TEST"
        )

        self.print(
            f"test_loss="
            f"{float(test_loss):.6f}"
        )

        self.print(
            f"mean_pearson="
            f"{float(mean_r):.6f}"
        )

        for gid, r in zip(
            self.gene_ids,
            per_gene_r.tolist(),
        ):

            self.print(
                f"{gid}: "
                f"r={r:.4f}"
            )

        self.print(
            "=" * 48
        )

        if self.trainer.is_global_zero:

            # ----------------------------------------------
            # Per-slide predictions
            # ----------------------------------------------
            pred_df = pd.DataFrame(
                all_preds.numpy(),
                columns=[
                    f"pred_{g}"
                    for g
                    in self.gene_ids
                ],
            )

            target_df = pd.DataFrame(
                all_targets.numpy(),
                columns=[
                    f"true_{g}"
                    for g
                    in self.gene_ids
                ],
            )

            result_df = pd.concat(
                [
                    pred_df,
                    target_df,
                ],
                axis=1,
            )

            result_df.insert(
                0,
                "Slide.ID",
                all_slide_ids,
            )

            result_df.to_csv(
                self.log_path
                / "test_predictions.csv",
                index=False,
            )

            # ----------------------------------------------
            # Summary
            # ----------------------------------------------
            summary = {
                "test_loss":
                    float(
                        test_loss
                    ),

                "test_mean_pearson":
                    float(
                        mean_r
                    ),
            }

            for gid, r in zip(
                self.gene_ids,
                per_gene_r.tolist(),
            ):

                summary[
                    f"pearson_{gid}"
                ] = float(r)

            pd.DataFrame(
                [summary]
            ).to_csv(
                self.log_path
                / "test_summary.csv",
                index=False,
            )

        self.test_step_outputs.clear()

    # ======================================================
    # Optimizer / scheduler
    # ======================================================
    def configure_optimizers(self):

        from MyOptimizer import (
            create_optimizer
        )

        optimizer = create_optimizer(
            self.optimizer_cfg,
            self.model,
        )

        scheduler = (
            torch.optim.lr_scheduler
            .CosineAnnealingLR(
                optimizer,
                T_max=max(
                    1,
                    self.trainer.max_epochs,
                ),
                eta_min=1e-7,
            )
        )

        return {
            "optimizer":
                optimizer,

            "lr_scheduler":
                scheduler,
        }

    # ======================================================
    # Legacy checkpoint compatibility
    # ======================================================
    def load_state_dict(
        self,
        state_dict,
        strict=True,
    ):

        state_dict = dict(
            state_dict
        )

        # Old classification-style TransMIL checkpoints
        # may contain this synthetic metadata key.
        state_dict.pop(
            "model._input_dim",
            None,
        )

        fc1_key = (
            "model._fc1.0.weight"
        )

        if (
            fc1_key in state_dict
            and hasattr(
                self.model,
                "_build_fc1",
            )
        ):

            checkpoint_dim = int(
                state_dict[
                    fc1_key
                ].shape[1]
            )

            current_dim = int(
                self.model._fc1[
                    0
                ].in_features
            )

            if (
                checkpoint_dim
                != current_dim
            ):

                self.model._build_fc1(
                    checkpoint_dim
                )

        return super().load_state_dict(
            state_dict,
            strict=strict,
        )
