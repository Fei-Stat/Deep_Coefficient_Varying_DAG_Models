import math

import torch
import torch.nn as nn
import torch.nn.functional as F
from nystrom_attention import NystromAttention


class TransLayer(nn.Module):
    """
    Transformer layer used by TransMIL.

    PreNorm + Nyström self-attention + residual connection.
    """

    def __init__(
        self,
        norm_layer=nn.LayerNorm,
        dim=512,
        dropout=0.1,
    ):
        super().__init__()

        self.norm = norm_layer(dim)

        self.attn = NystromAttention(
            dim=dim,
            dim_head=dim // 8,
            heads=8,
            num_landmarks=dim // 2,
            pinv_iterations=6,
            residual=True,
            dropout=dropout,
        )

    def forward(self, x):
        return x + self.attn(self.norm(x))


class PPEG(nn.Module):
    """
    Pyramid Position Encoding Generator.

    The non-CLS tokens are reshaped to a square pseudo-grid,
    followed by depthwise convolutions with several kernel sizes.
    """

    def __init__(self, dim=512):
        super().__init__()

        self.proj = nn.Conv2d(
            dim,
            dim,
            kernel_size=7,
            stride=1,
            padding=7 // 2,
            groups=dim,
        )

        self.proj1 = nn.Conv2d(
            dim,
            dim,
            kernel_size=5,
            stride=1,
            padding=5 // 2,
            groups=dim,
        )

        self.proj2 = nn.Conv2d(
            dim,
            dim,
            kernel_size=3,
            stride=1,
            padding=3 // 2,
            groups=dim,
        )

    def forward(self, x, H, W):

        B, _, C = x.shape

        cls_token = x[:, 0]
        feat_token = x[:, 1:]

        if feat_token.shape[1] != H * W:
            raise ValueError(
                f"PPEG expects H*W={H * W} feature tokens, "
                f"but received {feat_token.shape[1]}."
            )

        cnn_feat = (
            feat_token
            .transpose(1, 2)
            .contiguous()
            .view(B, C, H, W)
        )

        x = (
            cnn_feat
            + self.proj(cnn_feat)
            + self.proj1(cnn_feat)
            + self.proj2(cnn_feat)
        )

        x = x.flatten(2).transpose(1, 2).contiguous()

        x = torch.cat(
            (
                cls_token.unsqueeze(1),
                x,
            ),
            dim=1,
        )

        return x


class TransMIL(nn.Module):
    """
    Original TransMIL classification model.

    Parameters
    ----------
    n_classes:
        Number of output classes.

    dropout:
        Dropout probability.

    input_dim:
        Legacy name for tile feature dimension.
        If supplied, it overrides feat_dim.

    feat_dim:
        Dimension of each WSI tile feature.

        Examples
        --------
        Virchow2          : 2560
        CONCH / UNI       : 1024
        ResNet-50 trunc   : 1024
        ResNet-50 TCGA    : 2048
        DINO ViT-S/16     : 384
    """

    def __init__(
        self,
        n_classes,
        dropout=0.25,
        input_dim=None,
        feat_dim=1024,
    ):
        super().__init__()

        if input_dim is not None:
            feat_dim = input_dim

        if feat_dim is None:
            raise ValueError(
                "feat_dim/input_dim must be explicitly specified."
            )

        self.n_classes = int(n_classes)
        self.dropout = float(dropout)
        self.feat_dim = int(feat_dim)

        # --------------------------------------------------
        # Tile-level feature projection:
        #
        # [B, N, feat_dim]
        #       ->
        # [B, N, 512]
        # --------------------------------------------------
        self._build_fc1(self.feat_dim)

        # --------------------------------------------------
        # CLS token
        # --------------------------------------------------
        self.cls_token = nn.Parameter(
            torch.randn(1, 1, 512)
        )

        # --------------------------------------------------
        # TransMIL backbone
        # --------------------------------------------------
        self.layer1 = TransLayer(
            dim=512,
            dropout=self.dropout,
        )

        self.pos_layer = PPEG(
            dim=512
        )

        self.layer2 = TransLayer(
            dim=512,
            dropout=self.dropout,
        )

        self.norm = nn.LayerNorm(512)

        # --------------------------------------------------
        # Classification head
        # --------------------------------------------------
        self._fc2 = nn.Linear(
            512,
            self.n_classes,
        )

    def _build_fc1(self, feat_dim):
        """
        Build feature projection.

        Kept as a method mainly for legacy-checkpoint compatibility.
        """

        feat_dim = int(feat_dim)

        self._fc1 = nn.Sequential(
            nn.Linear(feat_dim, 512),
            nn.ReLU(),
            nn.Dropout(self.dropout),
        )

        self.feat_dim = feat_dim

    def encode(self, data):
        """
        Encode one or more WSI bags.

        Parameters
        ----------
        data:
            Tensor [B, N_tiles, feat_dim]

        Returns
        -------
        embedding:
            Tensor [B, 512]

        This is the key interface that can later be reused by
        DynamicDAG.
        """

        h = data.float()

        if h.ndim != 3:
            raise ValueError(
                "TransMIL expects data with shape "
                "[B, N_tiles, feat_dim], "
                f"but received shape {tuple(h.shape)}."
            )

        if h.shape[1] == 0:
            raise ValueError(
                "A WSI bag must contain at least one tile."
            )

        if h.shape[-1] != self.feat_dim:
            raise ValueError(
                f"Expected tile feature dimension {self.feat_dim}, "
                f"but received {h.shape[-1]}."
            )

        # --------------------------------------------------
        # Tile feature projection
        #
        # [B, N, feat_dim]
        #       ->
        # [B, N, 512]
        # --------------------------------------------------
        h = self._fc1(h)

        # --------------------------------------------------
        # Pad number of tiles to square number
        # --------------------------------------------------
        N = h.shape[1]

        H = int(math.ceil(math.sqrt(N)))
        W = H

        add_length = H * W - N

        if add_length > 0:
            h = torch.cat(
                [
                    h,
                    h[:, :add_length, :],
                ],
                dim=1,
            )

        # --------------------------------------------------
        # CLS token
        # --------------------------------------------------
        B = h.shape[0]

        cls_tokens = self.cls_token.expand(
            B,
            -1,
            -1,
        )

        h = torch.cat(
            (
                cls_tokens,
                h,
            ),
            dim=1,
        )

        # --------------------------------------------------
        # TransMIL
        # --------------------------------------------------
        h = self.layer1(h)

        h = self.pos_layer(
            h,
            H,
            W,
        )

        h = self.layer2(h)

        # --------------------------------------------------
        # Slide-level representation
        #
        # [B, N+1, 512]
        #       ->
        # [B, 512]
        #
        # THIS IS THE IMPORTANT DAG INTERFACE.
        # --------------------------------------------------
        embedding = self.norm(h)[:, 0]

        return embedding

    def forward(self, **kwargs):

        if "data" not in kwargs:
            raise KeyError(
                "TransMIL.forward() requires keyword argument `data`."
            )

        data = kwargs["data"]

        # --------------------------------------------------
        # WSI -> slide embedding
        # --------------------------------------------------
        embedding = self.encode(data)

        # --------------------------------------------------
        # Classification
        # --------------------------------------------------
        logits = self._fc2(
            embedding
        )

        Y_prob = F.softmax(
            logits,
            dim=1,
        )

        Y_hat = torch.argmax(
            logits,
            dim=1,
        )

        return {
            "logits": logits,
            "Y_prob": Y_prob,
            "Y_hat": Y_hat,

            # Expose slide-level representation.
            "embedding": embedding,
        }


if __name__ == "__main__":

    device = torch.device(
        "cuda" if torch.cuda.is_available() else "cpu"
    )

    B = 2
    N_tiles = 300
    feat_dim = 2560

    data = torch.randn(
        B,
        N_tiles,
        feat_dim,
        device=device,
    )

    model = TransMIL(
        n_classes=5,
        feat_dim=feat_dim,
    ).to(device)

    model.eval()

    with torch.no_grad():
        out = model(
            data=data
        )

    print(
        "logits:",
        out["logits"].shape,
    )

    print(
        "embedding:",
        out["embedding"].shape,
    )
